APP_URL=https://stilfinder.kuechen-klas.de
MAIL_TO=kontakt@kuechen-klas.de
MAIL_FROM=stilfinder@kuechen-klas.de
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# PHP mail() liefert auf den meisten Hosts nicht zuverlässig zu (kein
# konfigurierter MTA) - deshalb wie im Hauptprojekt (kuechen-klas.de-2026)
# Versand über SMTP/PHPMailer statt mail(). Ohne SMTP_HOST bleibt mail() als
# Fallback aktiv (unzuverlässig, aber besser als kein Versand).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL="stilfinder@kuechen-klas.de"
SMTP_FROM_NAME="Klas Küchen Stilfinder"

