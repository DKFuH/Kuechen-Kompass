APP_URL=https://stilfinder.kuechen-klas.de
MAIL_TO=kontakt@kuechen-klas.de
MAIL_FROM=stilfinder@kuechen-klas.de
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Personenbezogene Einträge in SQLite werden nach dieser Anzahl Tage entfernt.
RETENTION_DAYS=180

# Optional. Wenn leer, erzeugt die App beim ersten Zugriff automatisch ein
# zufälliges Secret unter storage/.rate-limit-secret.
RATE_LIMIT_SECRET=

# SMTP ist für den Produktivbetrieb empfohlen. Ohne SMTP_HOST bleibt PHP mail()
# als Fallback aktiv; alternativ kann n8n als Zustellweg genutzt werden.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
SMTP_FROM_EMAIL="stilfinder@kuechen-klas.de"
SMTP_FROM_NAME="Klas Küchen Küchen-Kompass"
